<IfModule mod_rewrite.c>
  Options -MultiViews
  DirectoryIndex index.html
  RewriteEngine On
  RewriteBase /

  # Never serve the React app for /api routes.
  RewriteCond %{REQUEST_URI} ^/api(/|$) [NC]
  RewriteRule ^api/?(.*)$ http://127.0.0.1:3001/api/$1 [P,L,NE]

  # Serve existing files and folders normally.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Let React Router handle direct visits like /admin and /noticia/1.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_proxy.c>
  ProxyPreserveHost On
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "index-d3394580\.js$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
